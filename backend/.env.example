NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://sababuka_app:change-me@127.0.0.1:5432/sababuka
COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
INVITATION_TTL_SECONDS=259200
MFA_ISSUER=SABABUKA Bersinar
# Hasil perintah: openssl rand -base64 32
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Master key untuk secret konektor (wajib untuk menyimpan API key BPS).
CONNECTOR_ENCRYPTION_KEY=replace-with-another-32-byte-base64-key
EVIDENCE_STORAGE_PATH=./storage/evidence
EVIDENCE_MAX_BYTES=10485760

# Konektor sumber eksternal. API key BPS hanya diisi pada environment lokal/rahasia.
BPS_API_KEY=
BPS_DOMAIN_CODE=6203

# Hanya digunakan oleh pnpm admin:create, jangan disimpan dalam Git.
SUPERADMIN_EMAIL=admin@example.go.id
SUPERADMIN_NAME=Superadmin SABABUKA
SUPERADMIN_PASSWORD=change-this-with-a-long-random-password
